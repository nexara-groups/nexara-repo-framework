# ---------------------------------------------------------------------------
# Nexara Foundation — environment variables
# Copy to `.env.local` for local dev. In production, set via `wrangler secret put`.
#
# NOTE: These are read ONLY by provider implementations (e.g. the Supabase
# providers) through PlatformProvider.getEnv(). Business logic never reads
# process.env directly.
# ---------------------------------------------------------------------------

APP_ENV=development

# --- Supabase (initial Database + Auth provider) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Active providers (swap these to migrate, no business-code changes) ---
# Options for DATABASE_PROVIDER: supabase | d1
DATABASE_PROVIDER=supabase
# Options for AUTH_PROVIDER: supabase | jwt | betterauth | clerk | auth0
AUTH_PROVIDER=supabase
# Options for PLATFORM_PROVIDER: cloudflare | aws
PLATFORM_PROVIDER=cloudflare

# --- Optional D1 JWT credentials provider ---
# D1 itself is a Cloudflare DB binding; set AUTH_* when AUTH_PROVIDER=jwt.
# AUTH_SECRET must contain at least 32 bytes.
# AUTH_SECRET=
# AUTH_TENANT_ID=
# AUTH_ISSUER=
# AUTH_AUDIENCE=

# --- Optional R2 media provider ---
# STORAGE_PROVIDER=r2
# MEDIA_PUBLIC_ORIGIN=https://media.example.test

# --- Optional transactional email providers ---
# EMAIL_PROVIDER=console
# EMAIL_FROM=Nexara <no-reply@example.test>
# STAGING_EMAIL_RECIPIENT_ALLOWLIST=qa@example.test
