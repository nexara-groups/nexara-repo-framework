{
  "name": "nexara-foundation",
  "version": "1.0.0",
  "private": true,
  "description": "Nexara Foundation V1 — provider-agnostic platform foundation (Next.js 15 + React 19 + Cloudflare Workers via OpenNext).",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:arch": "node scripts/check-architecture.mjs",
    "verify": "node scripts/check-architecture.mjs && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:release": "npm run verify && npm run build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "next": "15.5.21",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
